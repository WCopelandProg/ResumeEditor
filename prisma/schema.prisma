// Resume Editor — Prisma schema
//
// Architecture note on the content model:
// A resume's editable content (personal info + sections + entries + bullets)
// is stored as a single validated JSON document on `Resume.content` rather
// than as fully normalized rows. This mirrors how document editors (Notion,
// Google Docs) actually persist rich nested trees: the tree shape changes
// constantly (add/remove/reorder bullets, entries, sections) and a relational
// schema for every level would mean a cascade of tiny CRUD endpoints and
// N+1 queries for something that is always read/written as a whole document.
// The JSON is validated against a strict Zod schema (see src/lib/resume/types.ts)
// on every read and write, so it is never treated as an untyped blob at the
// application layer. Every node in the tree (section/entry/bullet) carries a
// stable string `id` (cuid) minted at creation time; those ids are what
// `Suggestion.sectionId/entryId/bulletId` point at, so AI suggestions and UI
// highlighting keep working across reorders and edits.
//
// Everything that is genuinely relational — users, auth, resumes themselves,
// version snapshots, suggestions, job descriptions, analysis runs, uploaded
// files, and style/formatting — stays as normal relational tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth schema)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  resumes  Resume[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Resumes
// ---------------------------------------------------------------------------

model Resume {
  id         String  @id @default(cuid())
  userId     String
  name       String
  targetRole String?
  templateId String  @default("modern")

  /// Validated StructuredResume JSON (personalInfo + sections/entries/bullets).
  /// See src/lib/resume/types.ts#StructuredResumeSchema.
  content Json

  sourceFileId String?       @unique
  sourceFile   UploadedFile? @relation("ResumeSourceFile", fields: [sourceFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  style           ResumeStyle?
  versions        ResumeVersion[]
  suggestions     Suggestion[]
  jobDescriptions JobDescription[]
  analysisResults AnalysisResult[]
  uploadedFiles   UploadedFile[]   @relation("ResumeUploadedFiles")

  @@index([userId])
  @@map("resumes")
}

model ResumeStyle {
  id String @id @default(cuid())

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  templateId       String  @default("modern")
  fontFamily       String  @default("Inter")
  fontSizePt       Int     @default(10)
  headingScale     Float   @default(1.15)
  lineSpacing      Float   @default(1.15)
  marginTopIn      Float   @default(0.6)
  marginRightIn    Float   @default(0.6)
  marginBottomIn   Float   @default(0.6)
  marginLeftIn     Float   @default(0.6)
  bulletSpacingPt  Int     @default(2)
  sectionSpacingPt Int     @default(10)
  alignment        String  @default("left") // left | justified
  accentColor      String  @default("#1d4ed8")
  showDividers     Boolean @default(true)
  columns          Int     @default(1) // 1 or 2

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resume_styles")
}

/// Named, restorable snapshots of a resume's full content+style.
model ResumeVersion {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  label      String
  isAutosave Boolean @default(false)

  /// Full StructuredResume JSON snapshot at time of save.
  content Json
  /// ResumeStyle field snapshot at time of save.
  style   Json

  createdAt DateTime @default(now())

  @@index([resumeId, createdAt])
  @@map("resume_versions")
}

enum SuggestionCategory {
  GRAMMAR
  CLARITY
  IMPACT
  QUANTIFICATION
  ACTION_VERB
  FORMATTING
  STRUCTURE
  ATS
  SKILLS
  REDUNDANCY
  RELEVANCE
  TONE
}

enum SuggestionSeverity {
  HIGH
  MEDIUM
  LOW
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EDITED
}

model Suggestion {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  category SuggestionCategory
  severity SuggestionSeverity
  status   SuggestionStatus   @default(PENDING)

  /// Stable ids into Resume.content's JSON tree — not foreign keys.
  sectionId String?
  entryId   String?
  bulletId  String?

  originalText  String? @db.Text
  suggestedText String? @db.Text
  finalText     String? @db.Text // set if user edited before accepting
  explanation   String  @db.Text
  question      String? @db.Text // "smart question" when info is missing instead of a rewrite

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId, status])
  @@map("suggestions")
}

model JobDescription {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  title   String?
  company String?
  rawText String  @db.Text

  createdAt DateTime @default(now())

  analysisResults AnalysisResult[]

  @@index([resumeId])
  @@map("job_descriptions")
}

model AnalysisResult {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  jobDescriptionId String?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)

  overallScore    Int
  /// { impact, clarity, conciseness, formatting, ats, quantification, actionVerbs, skills, grammar, relevance }
  categoryScores  Json
  atsScore        Int
  atsIssues       Json // string[] of explained issues
  healthChecklist Json // { label, passed }[]

  jobMatchScore    Int?
  missingKeywords  Json? // string[]
  matchExplanation Json? // string[] of explained factors

  createdAt DateTime @default(now())

  @@index([resumeId, createdAt])
  @@map("analysis_results")
}

enum ParseStatus {
  PENDING
  SUCCESS
  NO_TEXT_LAYER
  FAILED
}

model UploadedFile {
  id     String @id @default(cuid())
  userId String

  /// Resume this file was imported into (nullable while parsing in-flight).
  resumeId     String?
  resume       Resume? @relation("ResumeUploadedFiles", fields: [resumeId], references: [id], onDelete: SetNull)
  /// Reverse side of Resume.sourceFile (the file a given resume was created from).
  resumeSource Resume? @relation("ResumeSourceFile")

  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int

  parseStatus   ParseStatus @default(PENDING)
  extractedText String?     @db.Text
  parseError    String?     @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("uploaded_files")
}
