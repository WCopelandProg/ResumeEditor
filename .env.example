# --- Database -----------------------------------------------------------
# Local dev: `docker compose up -d` starts a matching Postgres instance.
DATABASE_URL="postgresql://resume_editor:resume_editor@localhost:5432/resume_editor?schema=public"

# --- Auth.js / NextAuth --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google sign-in. Leave blank to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI provider ----------------------------------------------------------
# Which provider powers the AI Resume Coach: "anthropic" | "openai"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# --- File storage -----------------------------------------------------------
# "local" | "s3"
STORAGE_PROVIDER="local"
# Local storage writes under ./.data/uploads (gitignored). No config needed.

# S3 / R2-compatible storage (only used when STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
